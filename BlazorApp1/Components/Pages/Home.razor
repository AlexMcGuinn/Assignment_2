@page "/"
@page "/home"

<PageTitle>Home</PageTitle>


<div class="welcome-section">
    <h2>Welcome back, @userName! 👋</h2>
    <p>Ready to manage your finances?</p>
</div>

<div class="summary-cards">
    <div class="card">
        <h3>Total Balance</h3>
        <p class="amount">$@totalBalance</p>
    </div>
    
    <div class="card">
        <h3>This Month's Spending</h3>
        <p class="amount spending">$@monthlySpending</p>
    </div>
    
    <div class="card">
        <h3>Budget Remaining</h3>
        <p class="amount">$@budgetRemaining</p>
    </div>
</div>

<div class="navigation-buttons">
    
    <a href="/transactions" class="btn btn-info">Transactions</a>
    <a href="/budget" class="btn btn-primary">Budget</a>
    <a href="/analytics" class="btn btn-success">Analytics</a>
</div>


@code
{

private string userName = "Username";  

private decimal totalBalance = 5240.50m;
private decimal monthlySpending = 1850.00m;
private decimal budgetRemaining = 1150.00m;
}

<style>
    .summary-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin: 30px 0;
    }
    
    .card {
        background: white;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        text-align: center;
    }
    
    .card h3 {
        color: #666;
        font-size: 14px;
        margin-bottom: 10px;
    }
    
    .amount {
        font-size: 32px;
        font-weight: bold;
        color: #A888B5;
        margin: 0;
    }
    
    
    
    .navigation-buttons {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }

    .navigation-buttons .btn {
    flex: 1;
    background-color: #A888B5;
    color: white;
    border: none;
    padding: 1px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
}

.navigation-buttons .btn:hover {
    background-color: #8E6F9D;
}

.welcome-section {
    margin-bottom: 40px;
}

.welcome-section h2 {
    font-size: 28px;
    color: #333;
    margin-bottom: 5px;
}

.welcome-section p {
    color: #666;
    font-size: 16px;
}

.summary-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    margin: 40px 0;
}

.card {
    background: linear-gradient(135deg, #A888B5 0%, #8E6F9D 100%);
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(168, 136, 181, 0.2);
    text-align: center;
    transition: transform 0.2s;
}

.card:hover {
    transform: translateY(-5px);
}

.card h3 {
    color: rgba(255, 255, 255, 0.9);
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
}

.amount {
    font-size: 36px;
    font-weight: bold;
    color: white;
    margin: 0;
}

.navigation-buttons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 50px;
}

.navigation-buttons .btn {
    background: white;
    color: #A888B5;
    border: 2px solid #A888B5;
    padding: 15px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    transition: all 0.3s;
}

.navigation-buttons .btn:hover {
    background-color: #A888B5;
    color: white;
}
</style>
